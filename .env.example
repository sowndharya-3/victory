# Live API origin, baked into the bundle at build time. Required: `npm run build` fails when it is missing
# or points at localhost/127.0.0.1. No trailing slash.
VITE_API_URL=https://api.example.com
# Local verification builds only (never for an upload): allow a localhost / unset VITE_API_URL in `npm run build`.
# VITE_ALLOW_LOCAL_API=1
