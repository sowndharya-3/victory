# SPA fallback for Apache / shared hosting (Hostinger, cPanel). Vite copies this file into dist/.
# Deep links like /admin/orders or /read/2 have no file on disk; serve index.html and let React Router route.
# The API lives on another origin (VITE_API_URL), so nothing here proxies or rewrites /api.
# Every directive is wrapped in <IfModule>, so a host without a module serves the site rather than a 500.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files (bundles, images) and directories are served as is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # A missing bundle must 404, not return HTML (a stale tab would hit a confusing MIME error instead).
  RewriteRule ^assets/ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# No mod_rewrite: deep links still load the app through the 404 handler (the HTTP status stays 404).
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # index.html is revalidated on every load so a new deploy is picked up at once.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite's content-hashed build files (name-AbC123xY.js) never change: cache for a year.
  # ponytail: matches by the 8-char hash suffix, so unhashed files from public/assets (logo.jpeg) are not frozen.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
