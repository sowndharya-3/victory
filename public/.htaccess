# SPA fallback for Apache / shared hosting (Hostinger, cPanel). Vite copies this file into dist/.
# Deep links like /admin/orders or /read/2 have no file on disk; serve index.html and let React Router route.
# The API is either on another origin (VITE_API_URL) or on this host under /api (see below).
# Every directive is wrapped in <IfModule>, so a host without a module serves the site rather than a 500.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files (bundles, images) and directories are served as is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # A missing bundle must 404, not return HTML (a stale tab would hit a confusing MIME error instead).
  RewriteRule ^assets/ - [L]
  # Same-host API (Hostinger layout, docs/deployment/hostinger-deploy.md): public_html/api is a symlink to
  # vtee-backend/public and has its own .htaccess. Harmless when the API is on another origin (no /api path exists).
  RewriteRule ^api/ - [L]
  # Book covers/index files are written by the API under its public/uploads; serve them from /uploads too.
  RewriteRule ^uploads/(.*)$ api/uploads/$1 [L]
  RewriteRule ^ index.html [L]
</IfModule>

# No mod_rewrite: deep links still load the app through the 404 handler (the HTTP status stays 404).
<IfModule !mod_rewrite.c>
  ErrorDocument 404 /index.html
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy 'camera=(), microphone=(), geolocation=(), payment=(self "https://checkout.razorpay.com" "https://api.razorpay.com")'
  # Report-Only: violations are logged in the browser console, nothing is blocked. Enforce after a clean week:
  # rename to Content-Security-Policy. https://API_ORIGIN_PLACEHOLDER is replaced at build time by the origin of
  # VITE_API_URL (vite.apiUrlCheck.js); the built dist/.htaccess never contains it. Keep in sync with public/_headers.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: blob: https://API_ORIGIN_PLACEHOLDER https://images.unsplash.com https://via.placeholder.com https://*.razorpay.com; connect-src 'self' https://API_ORIGIN_PLACEHOLDER https://*.razorpay.com; frame-src https://API_ORIGIN_PLACEHOLDER https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  # HSTS: enable only once HTTPS works on this exact host; start low and raise (300 -> 86400 -> 15552000).
  # Header always set Strict-Transport-Security "max-age=300" "expr=%{HTTPS} == 'on'"
  # index.html is revalidated on every load so a new deploy is picked up at once.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite's content-hashed build files (name-AbC123xY.js) never change: cache for a year.
  # ponytail: matches by the 8-char hash suffix, so unhashed files from public/assets (logo.jpeg) are not frozen.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
