# Netlify / Cloudflare Pages response headers. Copied to dist/ by `vite build`.
# https://API_ORIGIN_PLACEHOLDER is replaced at build time by the origin of VITE_API_URL (vite.apiUrlCheck.js),
# so the built dist/_headers never contains the placeholder. Keep this policy in sync with public/.htaccess.
# Report-Only: violations are logged in the browser console, nothing is blocked. After a clean week on live
# traffic rename the header to Content-Security-Policy to enforce it.
# HSTS: enable only once HTTPS works on this exact host (add under /*: Strict-Transport-Security: max-age=300);
# start low and raise (300 -> 86400 -> 15552000).
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://checkout.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: blob: https://API_ORIGIN_PLACEHOLDER https://images.unsplash.com https://via.placeholder.com https://*.razorpay.com; connect-src 'self' https://API_ORIGIN_PLACEHOLDER https://*.razorpay.com; frame-src https://API_ORIGIN_PLACEHOLDER https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://checkout.razorpay.com" "https://api.razorpay.com")
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
/index.html
  Cache-Control: no-cache
# ponytail: no long-cache rule for /assets/*: public/assets holds unhashed images (logo.jpeg) next to the hashed bundles
# and _headers has no regex. Hosts already revalidate static files by ETag.
