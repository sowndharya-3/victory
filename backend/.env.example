DB_HOST=mysql
DB_PORT=3306
DB_NAME=vtee
DB_USER=vtee
DB_PASS=changeme
# Generate a real one before use: php -r 'echo bin2hex(random_bytes(32));'
# The server refuses to start with this placeholder value or anything under 32 bytes.
JWT_SECRET=changeme-generate-a-real-random-secret
FRONTEND_ORIGIN=http://localhost:5173

# SP-5 orders/payments. Validated lazily (at use), never at boot. Check a deploy with:
#   php backend/scripts/check_config.php
# APP_ENV: only the exact values development|dev|local|test|testing count as dev. Anything else
# (unset, staging, Production, ...) is treated as production: the fake gateway is refused and
# placeholder / short secrets are rejected.
APP_ENV=production
# RAZORPAY_GATEWAY: live | fake. "fake" accepts forged payment signatures: LOCAL TESTS ONLY, and only
# with a dev APP_ENV. For the local Docker test suite set APP_ENV=development and RAZORPAY_GATEWAY=fake
# in backend/.env (the test scripts also need non-empty RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET).
RAZORPAY_GATEWAY=live
# Outside dev: key id must start rzp_test_ or rzp_live_; key secret >= 20 chars; webhook secret
# (set the same value in the Razorpay dashboard) >= 32 chars. No placeholder words.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# CODE_SECRET must be >=32 random bytes; the placeholder is rejected.
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
CODE_SECRET=changeme-generate-a-real-random-secret
