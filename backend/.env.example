DB_HOST=mysql
DB_PORT=3306
DB_NAME=vtee
DB_USER=vtee
DB_PASS=changeme
# Generate a real one before use: php -r 'echo bin2hex(random_bytes(32));'
# The server refuses to start with this placeholder value or anything under 32 bytes.
JWT_SECRET=changeme-generate-a-real-random-secret
FRONTEND_ORIGIN=http://localhost:5173

# SP-5 orders/payments. Validated lazily (at use), never at boot.
# APP_ENV: development | production. The fake gateway is forbidden in production.
APP_ENV=development
# RAZORPAY_GATEWAY: live | fake. "fake" is dev/test-only; placeholders below are rejected when live.
RAZORPAY_GATEWAY=fake
RAZORPAY_KEY_ID=rzp_test_changeme
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_WEBHOOK_SECRET=changeme
# CODE_SECRET must be >=32 random bytes; the placeholder is rejected.
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
CODE_SECRET=changeme-generate-a-real-random-secret
